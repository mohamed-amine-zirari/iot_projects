        "func": "const temp = Number(msg.payload);\n// keep last 5 readings\nlet arr = context.get(\"temps\") || [];\narr.push(temp);\nif (arr.length > 5) arr.shift();\ncontext.set(\"temps\", arr);\n\n// rule: last 5 are increasing AND total rise >= 0.8°C\nlet rising = false;\nif (arr.length === 5) {\n    const increasing = arr[1] > arr[0] && arr[2] > arr[1] && arr[3] > arr[2] && arr[4] > arr[3];\n    const totalRise = arr[4] - arr[0];\n    rising = increasing && totalRise >= 0.8;\n}\nmsg.payload = rising; // true/false for the next nodes\nreturn msg;",
